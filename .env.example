# Runtime stays offline until both provider configuration and credentials exist.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Generate and set a long random secret before accepting authenticated requests.
APP_TOKEN=
APP_SERVER_ROLE=analyst
APP_ALLOWED_ROLES=analyst
APP_ALLOW_ADK_CLI=false

# Immutable index and metadata-only audit locations.
APP_INDEX_PATH=data/index.json
# Set APP_INDEX_SHA256 to the approved 64-character index hash after ingestion.
# APP_INDEX_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_AUDIT_PATH=data/audit/events.jsonl
APP_MAX_SESSION_TURNS=8
APP_SESSION_TTL_SECONDS=3600

# All ADK LLM agents use this exact model.
APP_ENABLE_MODEL_CALLS=false
APP_MODEL_PROVIDER=disabled
APP_MODEL=gemini-3.1-flash-lite
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Per-request limits; prospective input is estimated. ADK_MAX_LLM_CALLS adds a framework cap.
APP_EMBEDDING_TIMEOUT_MS=20000
APP_MODEL_TIMEOUT_MS=30000
APP_MAX_MODEL_CALLS=8
APP_MAX_TOOL_CALLS=8
APP_MAX_INPUT_TOKENS=80000
APP_MAX_OUTPUT_TOKENS=7200
APP_MAX_OUTPUT_TOKENS_PER_CALL=900
APP_MAX_REQUEST_SECONDS=120
APP_MAX_SEARCH_RESULTS=8
APP_MAX_SEARCH_QUERY_CHARS=1200
# Exact current question plus the model's bounded search refinement.
APP_MAX_EFFECTIVE_SEARCH_QUERY_CHARS=7500
APP_MAX_EVIDENCE_CHARS=24000
ADK_MAX_LLM_CALLS=8

# Ingestion defaults to lexical. Vertex is explicit opt-in and can incur cost.
APP_EMBEDDING_PROVIDER=lexical
APP_EMBEDDING_MODEL=gemini-embedding-001
APP_EMBEDDING_DIMENSIONS=768
EMBEDDING_LOCATION=us-central1
